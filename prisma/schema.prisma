generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * === ENUMS ===
 */
enum OrderStatus {
  draft
  in_progress
  done
  paid
  cancelled
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum PaymentMethod {
  cash
  card
  bank_transfer
}

enum ItemType {
  service
  product
}

/**
 * === COMPANY & USERS ===
 */
model Company {
  id        String  @id @default(cuid())
  name      String
  legalName String?
  vatNumber String? // UAE TRN
  country   String? // AE
  currency  String? // AED
  phone     String?
  email     String?
  address   String?

  users      User[]
  customers  Customer[]
  vehicles   Vehicle[]
  items      Item[]
  taxes      Tax[]
  priceLists PriceList[]
  orders     ServiceOrder[]
  payments   Payment[]
  settings   Settings?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings {
  id                 String  @id @default(cuid())
  companyId          String  @unique
  company            Company @relation(fields: [companyId], references: [id])
  defaultPriceListId String?
  defaultTaxId       String?
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  fullName  String?
  role      String   @default("admin")
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * === CUSTOMERS & VEHICLES ===
 */
model Customer {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  name  String
  phone String?
  email String?
  notes String?

  vehicles Vehicle[]
  orders   ServiceOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, name])
  @@index([phone])
  @@index([email])
}

model Vehicle {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  plate      String
  brand      String?
  model      String?
  color      String?
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  orders ServiceOrder[]

  @@unique([companyId, plate])
  @@index([customerId])
}

/**
 * === TAX & PRICE LISTS ===
 */
model Tax {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  name      String // e.g., UAE VAT 5%
  rate      Decimal @db.Decimal(5, 2)
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // opposite side of Item.defaultTax
  itemsWithDefault Item[] @relation("ItemDefaultTax")

  @@index([companyId, isDefault])
}

model PriceList {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  isDefault Boolean @default(false)

  lines  PriceListItem[]
  // opposite side of ServiceOrder.priceList
  orders ServiceOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
}

model PriceListItem {
  id          String    @id @default(cuid())
  priceListId String
  priceList   PriceList @relation(fields: [priceListId], references: [id])
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id])
  price       Decimal   @db.Decimal(12, 2)

  @@unique([priceListId, itemId])
}

/**
 * === ITEMS ===
 */
model Item {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  name         String
  type         ItemType
  sku          String?
  taxable      Boolean  @default(true)
  defaultTaxId String?
  defaultTax   Tax?     @relation("ItemDefaultTax", fields: [defaultTaxId], references: [id])
  active       Boolean  @default(true)

  priceListLines PriceListItem[]
  orderLines     ServiceOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([sku])
  @@index([companyId, type])
}

/**
 * === ORDERS & PAYMENTS ===
 */
model ServiceOrder {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  orderNo Int         @default(autoincrement())
  status  OrderStatus @default(draft)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  priceListId String?
  priceList   PriceList? @relation(fields: [priceListId], references: [id])

  subtotal  Decimal @default(0) @db.Decimal(12, 2)
  taxTotal  Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @default(0) @db.Decimal(12, 2)
  paidTotal Decimal @default(0) @db.Decimal(12, 2)

  notes String?

  lines    ServiceOrderLine[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, orderNo])
  @@index([status])
  @@index([customerId])
  @@index([vehicleId])
}

model ServiceOrderLine {
  id      String       @id @default(cuid())
  orderId String
  order   ServiceOrder @relation(fields: [orderId], references: [id])

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  description  String?
  qty          Decimal @default(1) @db.Decimal(12, 3)
  unitPrice    Decimal @db.Decimal(12, 2)
  lineSubtotal Decimal @db.Decimal(12, 2) // qty * unitPrice
  taxRate      Decimal @default(0) @db.Decimal(5, 2) // snapshot
  taxAmount    Decimal @default(0) @db.Decimal(12, 2)
  lineTotal    Decimal @db.Decimal(12, 2) // lineSubtotal + taxAmount

  @@index([orderId])
  @@index([itemId])
}

model Payment {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  orderId String
  order   ServiceOrder @relation(fields: [orderId], references: [id])

  method PaymentMethod
  status PaymentStatus @default(pending)
  amount Decimal       @db.Decimal(12, 2)

  reference  String?
  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([companyId])
  @@index([orderId])
  @@index([status])
}
